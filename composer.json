{
    "name": "aliu-zhongzheng/laravel-compat",
    "description": "Static compatibility audit for legacy Laravel/PHP projects: PHPCompatibility findings aggregated into a human-readable report.",
    "type": "library",
    "keywords": [
        "laravel",
        "php",
        "compatibility",
        "static-analysis",
        "phpcompatibility",
        "php-codesniffer",
        "migration",
        "php8",
        "upgrade",
        "audit"
    ],
    "license": "MIT",
    "bin": [
        "bin/scan"
    ],
    "require": {
        "php": ">=8.2",
        "squizlabs/php_codesniffer": "^3.7",
        "phpcompatibility/php-compatibility": "^9.3"
    },
    "autoload": {
        "psr-4": {
            "LaravelCompat\\": "src/"
        }
    }
}
